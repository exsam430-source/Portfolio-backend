# ─────────────────────────────────────────────
#  SERVER
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# Comma separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173

# ─────────────────────────────────────────────
#  DATABASE (MongoDB Atlas or local)
# ─────────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/portfolio
# Atlas:  mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/portfolio?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/portfolio

# ─────────────────────────────────────────────
#  AUTH (admin dashboard / protected routes)
# ─────────────────────────────────────────────
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Used by `npm run seed:admin` to create the first admin user
ADMIN_NAME=Muhammad Abdullah
ADMIN_EMAIL=exsam430@gmail.com
ADMIN_PASSWORD=ChangeMe123!

# ─────────────────────────────────────────────
#  EMAIL (Nodemailer)
#  Gmail: enable 2FA then create an "App password"
#  Leave blank to run in "log only" mode (no crash).
# ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=exsam430@gmail.com
SMTP_PASS=your_16_char_app_password

# Where notification mails are delivered + the "From" identity
MAIL_FROM_NAME=Muhammad Abdullah
MAIL_FROM=exsam430@gmail.com
ADMIN_NOTIFY_EMAIL=exsam430@gmail.com

# Shown in email templates / links
SITE_NAME=Muhammad Abdullah — Full-Stack MERN Developer
SITE_URL=http://localhost:5173
